{
  "name": "bbj-tools",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "npm-run-all --sequential buildwp tailwindbuild",
    "start": "npm-run-all --parallel wpstart tailwindwatch",
    "wpstart": "wp-scripts start",
    "tailwindbuild": "tailwindcss -i ./src/index.css -o ./tailwind/index-style.css --minify",
    "tailwindwatch": "tailwindcss -i ./src/index.css -o ./tailwind/index-style.css --watch --minify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stevebeans/bbj-tools.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Stevebeans/bbj-tools/issues"
  },
  "homepage": "https://github.com/Stevebeans/bbj-tools#readme",
  "devDependencies": {
    "autoprefixer": "^10.4.14",
    "css-loader": "^6.8.1",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.27",
    "postcss-loader": "^7.3.3",
    "tailwind-watch": "^0.0.6",
    "tailwindcss": "^3.2.7"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.4.2",
    "@fortawesome/free-solid-svg-icons": "^6.4.2",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@react-google-maps/api": "^2.19.2",
    "@wordpress/scripts": "^30.7.0",
    "google-map-react": "^2.2.1",
    "npm-run-all": "^4.1.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-google-places-autocomplete": "^4.0.1",
    "react-router-dom": "^6.15.0"
  }
}
