{
  "folders": [
    {
      "name": "theme",
      "path": "./wp-content/themes/BBJ"
    },
    {
      "name": "plugins",
      "path": "./wp-content/plugins/bbj-tools"
    }
  ],
  "settings": {
    "files.exclude": {
      "**/.git": true,
      "**/node_modules": true,
      "**/vendor": true
    },
    "search.exclude": {
      "**/node_modules": true,
      "**/vendor": true,
      "**/build": true
    },
    "intelephense.environment.includePaths": ["wp-content/themes/my-theme", "wp-content/plugins/my-plugin"]
  }
}
